# Django Core & Security
SECRET_KEY=generate_a_random_secure_django_secret_key_for_production
DEBUG=False
ALLOWED_HOSTS=yamunastore.com,www.yamunastore.com,api.yamunastore.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://yamunastore.com,https://www.yamunastore.com,http://localhost:5173

# MySQL Database Configuration
DB_NAME=yamuna_store
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# Cloudinary Media Storage (Already active)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Store Bank Details (Served strictly to authenticated customers for international wire transfers)
STORE_BANK_ACCOUNT_NAME=Yamuna Store
STORE_BANK_NAME=State Bank of India
STORE_BANK_ACCOUNT_NUMBER=000000000000
STORE_BANK_ACCOUNT_TYPE=Current / Business Account
STORE_BANK_IFSC=SBIN0000000
STORE_BANK_SWIFT=SBININBBXXX
STORE_BANK_BRANCH=Vrindavan Dham Branch, Mathura, Uttar Pradesh, 281121, India
STORE_BANK_CURRENCIES=USD ($), EUR (€), GBP (£), AUD (A$), CAD (C$), INR (₹)
STORE_BANK_NOTES=Please mention your Order Number in the wire transfer description / remarks.

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
